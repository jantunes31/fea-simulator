#100 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#101)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#102,#103,#104)) REPRESENTATION_CONTEXT('Context','3D') );
#101 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-6),#102,'distance_accuracy_value','');
#102 = ( CONVERSION_BASED_UNIT('MILLIMETRE',#105) LENGTH_UNIT() NAMED_UNIT(#106) );
