/* x=0 face normal -X */
#160 = ORIENTED_EDGE('',*,*,#93,.F.);
#161 = ORIENTED_EDGE('',*,*,#98,.T.);
#162 = ORIENTED_EDGE('',*,*,#97,.F.);
#163 = ORIENTED_EDGE('',*,*,#111,.F.);
