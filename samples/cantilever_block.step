#106 = DIMENSIONAL_EXPONENTS(1.,0.,0.,0.,0.,0.,0.);
#107 = ( LENGTH_UNIT() NAMED_UNIT(#106) SI_UNIT(.MILLI.,.METRE.) );
#103 = ( NAMED_UNIT(#108) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#108 = DIMENSIONAL_EXPONENTS(0.,0.,0.,0.,0.,0.,0.);
#204 = ( NAMED_UNIT(#108) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#104 = #204;
#200 = AXIS2_PLACEMENT_3D('',#20,#21,#22);
ENDSEC;
